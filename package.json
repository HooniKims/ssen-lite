{
  "name": "ssen-lite",
  "version": "1.0.0",
  "description": "HWPX 문서 속 이미지 용량을 일괄로 줄이는 오프라인 앱",
  "author": "HooniKim",
  "private": true,
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:native": "node scripts/build-native.cjs",
    "samples": "node scripts/create-samples.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "dist": "npm run build:native && electron-builder --win nsis zip --x64 --publish never",
    "release": "node scripts/release.cjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "buffer-crc32": "^1.0.0",
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.5",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "kr.hoonikim.ssenlite",
    "productName": "쎈Lite",
    "directories": { "output": "release" },
    "files": ["app/**/*", "src/**/*", "assets/**/*", "package.json"],
    "extraResources": [{ "from": "native/bin", "to": "native", "filter": ["*.exe"] }],
    "asarUnpack": ["node_modules/sharp/**/*", "node_modules/@img/**/*"],
    "publish": { "provider": "github", "owner": "HooniKims", "repo": "ssen-lite", "releaseType": "release" },
    "win": { "icon": "assets/icon.ico", "executableName": "SsenLite", "artifactName": "SsenLite-${version}-${arch}.${ext}" },
    "nsis": {
      "artifactName": "SsenLite-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "쎈Lite",
      "runAfterFinish": true,
      "installerLanguages": ["ko_KR"],
      "include": "build/installer.nsh",
      "installerSidebar": "build/installer/sidebar.bmp",
      "installerHeader": "build/installer/header.bmp"
    }
  }
}
